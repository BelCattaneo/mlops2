%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial, Helvetica, sans-serif", "fontSize": "14px", "lineColor": "#8792A2", "clusterBkg": "#F7F9FB", "clusterBorder": "#C9D0DA", "edgeLabelBackground": "#FFFFFF"}, "flowchart": {"curve": "basis", "nodeSpacing": 20, "rankSpacing": 44}}}%%
flowchart TB
  classDef infra fill:#E8F0FB,stroke:#3A6EA5,color:#16324F,stroke-width:1.5px
  classDef etapa fill:#E6F4EA,stroke:#2E7D4F,color:#173D27,stroke-width:1.2px
  classDef dato fill:#FFF6E0,stroke:#C98A00,color:#5A3E00,stroke-width:1.2px
  classDef paquete fill:#F3E8FD,stroke:#7B3FA0,color:#3B1A52,stroke-width:1.5px
  classDef externo fill:#FFFFFF,stroke:#8A8A8A,color:#333333,stroke-width:1.5px

  SOC["Socrata · datos abiertos de Chicago<br/>ijzp-q8t2 crímenes · z8bn-74gv comisarías"]:::externo

  subgraph orq["Orquestación · Airflow 3.0.2 con LocalExecutor"]
    direction TB
    APS["airflow-apiserver :8081"]:::infra
    SCH["airflow-scheduler<br/>corre las tareas en su proceso"]:::infra
    DGP["airflow-dag-processor"]:::infra
    TRG["airflow-triggerer"]:::infra
  end

  subgraph dags["Dos DAGs, acoplados solo por la capa curada"]
    direction TB
    subgraph etl["etl_with_taskflow · mensual · 5 tareas · max_active_runs=1"]
      direction TB
      E1["setup_s3<br/>bucket, versionado y retención por capa"]:::etapa
      E2["land_raw<br/>ventana de 365 días · carga inicial si falta el histórico"]:::etapa
      E3["build_enriched<br/>junta las particiones, enriquece y limpia"]:::etapa
      E4["build_curated<br/>outliers, frecuencias, escalado y contrato"]:::etapa
      E5["log_summary<br/>conteos por XCom, sin releer el bucket"]:::etapa
      E1 --> E2 --> E3 --> E4 --> E5
    end
    TRA["train_arrest_model · manual<br/>train_and_register: peso de clase,<br/>umbral sobre validación, alias champion"]:::etapa
  end

  subgraph lake["Data lake · MinIO :9000 · consola :9001"]
    direction TB
    subgraph data["s3://data · bucket versionado"]
      direction TB
      RAW[("raw/crimes/month=YYYY-MM/crimes.csv<br/>raw/police_stations/<br/>CSV tal como llegó · se conserva")]:::dato
      ENR[("enriched/crimes/date=YYYY-MM-DD/<br/>Parquet · expira a los 30 días")]:::dato
      CUR[("curated/train · test · params/date=YYYY-MM-DD/<br/>Parquet + params.json · se conserva")]:::dato
    end
    ART[("s3://mlflow<br/>artefactos de modelos")]:::dato
  end

  subgraph ciclo["Ciclo de vida"]
    direction TB
    MLF["MLflow 3.16.1 :5001<br/>tracking + Model Registry · alias champion"]:::infra
    PG[("PostgreSQL :5433<br/>metadata de Airflow y mlflow_db")]:::infra
  end

  subgraph pkg["Paquete compartido arrest_model"]
    direction TB
    SCM["schemas.py · contrato de los 6 campos crudos"]:::paquete
    FEA["features.py · las 7 features, una función por feature"]:::paquete
    MOD["model.py · predice y decide con el umbral del modelo"]:::paquete
    PAR["params.py · frecuencias, escaladores y comisarías en JSON"]:::paquete
    REG["registry.py · el .pkl del repo o el champion del registro"]:::paquete
    SRV["serving.py · pyfunc que recibe los campos crudos"]:::paquete
  end

  subgraph serv["Servicio · perfil serving"]
    direction TB
    REST["REST :8002<br/>/v1/predict · /batch · /metadata · /health<br/>el único protocolo: ver las decisiones"]:::infra
  end

  SOC -->|"descarga incremental"| etl
  orq -.->|"ejecuta las tareas"| dags
  E2 --> RAW
  E3 --> ENR
  E4 --> CUR
  CUR -->|"la partición escrita más reciente"| TRA
  TRA -->|"modelo pyfunc + params + umbral"| MLF
  MLF --- PG
  MLF --- ART
  E5 -.->|"47 métricas de datos"| MLF
  MLF -->|"models:/chicago-arrest-xgboost@champion"| serv
  pkg -.->|"la misma codificación al entrenar y al servir"| serv
  pkg -.-> TRA
  serv --> CLI["apps y analistas"]:::externo

  subgraph ref2["Referencias"]
    direction TB
    R1["servicio del compose"]:::infra
    R2["tarea de un DAG"]:::etapa
    R3["dato en el lake"]:::dato
    R4["paquete compartido"]:::paquete
  end
  CLI ~~~ ref2
