# Copiar a .env y ajustar. El .env no se versiona: ahí van los secretos.

# Airflow corre con el usuario del host para que los logs no queden como root.
AIRFLOW_UID=50000

# Puertos en la máquina. Los valores por defecto evitan los que suele ocupar otro stack:
# 8080 y 5432 son los más disputados.
AIRFLOW_PORT=8081
PG_PORT=5433
MLFLOW_PORT=5001
MINIO_PORT=9000
MINIO_PORT_UI=9001
# La API cuando corre dentro de la plataforma (perfil `serving`). Distinto del 8000 que
# publica el contenedor suelto del mini-TP 1.
STACK_REST_PORT=8002
# Con qué firma el servicio REST de la plataforma los tokens de acceso: mínimo 32 bytes, y sin
# esto el servicio no arranca. Los tokens se emiten con `make stack-token`.
REST_JWT_SECRET=cambiar-este-secreto-por-otro-de-32-bytes-o-mas

# El grafo de linaje. Son otros puertos que el `neo4j-tp` del Makefile, que publica en 7474 y 7687.
STACK_NEO4J_HTTP_PORT=7475
STACK_NEO4J_BOLT_PORT=7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpass

# PostgreSQL, que guarda la metadata de Airflow y la de MLflow.
PG_USER=airflow
PG_PASSWORD=airflow
PG_DATABASE=airflow

# MinIO, que hace de almacenamiento S3 para los datasets y los artefactos de modelos.
# Esta es la credencial root, y la usan solo MinIO y el contenedor que crea buckets y usuarios.
MINIO_ACCESS_KEY=minio
MINIO_SECRET_ACCESS_KEY=minio123
MLFLOW_BUCKET_NAME=mlflow
DATA_REPO_BUCKET_NAME=data

# Una credencial por servicio, con lo mínimo que cada uno necesita: Airflow es dueño del bucket
# de datos y escribe artefactos, MLflow administra el suyo, y el servicio que sirve el modelo
# solo lee. El secreto de MinIO va de 8 a 40 caracteres.
AIRFLOW_MINIO_KEY=airflow-svc
AIRFLOW_MINIO_SECRET=airflow-svc-secret
MLFLOW_MINIO_KEY=mlflow-svc
MLFLOW_MINIO_SECRET=mlflow-svc-secret
REST_MINIO_KEY=rest-svc
REST_MINIO_SECRET=rest-svc-secret

# Token de la API de datos abiertos de Chicago. Se saca gratis en
# https://data.cityofchicago.org/profile/edit/developer_settings
# Sin token la ingesta igual funciona: cae al CSV de respaldo versionado en el repo.
SOCRATA_APP_TOKEN=
